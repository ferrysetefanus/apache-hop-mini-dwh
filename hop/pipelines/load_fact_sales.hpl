<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>load_fact_sales</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline ETL untuk memetakan Surrogate Keys dan memuat data fakta penjualan ke fact_sales</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/16 10:00:00.000</created_date>
    <modified_date>2026/10/16 10:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>Read raw_transactions.csv</name>
    <filename>${PROJECT_HOME}/data/raw/raw_transactions.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field>
        <name>transaction_id</name>
        <length>100</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>transaction_date</name>
        <length>-1</length>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>customer_id</name>
        <length>50</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>product_id</name>
        <length>50</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>store_id</name>
        <length>50</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>quantity</name>
        <length>9</length>
        <type>Integer</type>
        <format>#</format>
        <trim_type>both</trim_type>
        <precision>0</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>unit_price</name>
        <length>12</length>
        <type>Number</type>
        <format>#0.00</format>
        <trim_type>both</trim_type>
        <precision>2</precision>
        <currency/>
        <decimal>.</decimal>
        <group/>
      </field>
      <field>
        <name>gross_amount</name>
        <length>14</length>
        <type>Number</type>
        <format>#0.00</format>
        <trim_type>both</trim_type>
        <precision>2</precision>
        <currency/>
        <decimal>.</decimal>
        <group/>
      </field>
      <field>
        <name>discount_amount</name>
        <length>14</length>
        <type>Number</type>
        <format>#0.00</format>
        <trim_type>both</trim_type>
        <precision>2</precision>
        <currency/>
        <decimal>.</decimal>
        <group/>
      </field>
      <field>
        <name>net_amount</name>
        <length>14</length>
        <type>Number</type>
        <format>#0.00</format>
        <trim_type>both</trim_type>
        <precision>2</precision>
        <currency/>
        <decimal>.</decimal>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>112</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup Date SK</name>
    <connection>mysql_dwh</connection>
    <cache>Y</cache>
    <cache_size>1000</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <schema/>
      <table>dim_date</table>
      <key>
        <name>transaction_date</name>
        <name2/>
        <condition>=</condition>
        <field>full_date</field>
      </key>
      <value>
        <name>date_sk</name>
        <rename>date_sk</rename>
        <default/>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <orderby/>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>288</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup Customer SK</name>
    <connection>mysql_dwh</connection>
    <cache>Y</cache>
    <cache_size>1000</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <table>dim_customer</table>
      <key>
        <name>customer_id</name>
        <condition>=</condition>
        <field>customer_id</field>
      </key>
      <value>
        <name>customer_sk</name>
        <rename>customer_sk</rename>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>464</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup Product SK</name>
    <connection>mysql_dwh</connection>
    <cache>Y</cache>
    <cache_size>1000</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <table>dim_product</table>
      <key>
        <name>product_id</name>
        <condition>=</condition>
        <field>product_id</field>
      </key>
      <value>
        <name>product_sk</name>
        <rename>product_sk</rename>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>640</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>DBLookup</type>
    <name>Lookup Store SK</name>
    <connection>mysql_dwh</connection>
    <cache>Y</cache>
    <cache_size>1000</cache_size>
    <cache_load_all>Y</cache_load_all>
    <lookup>
      <table>dim_store</table>
      <key>
        <name>store_id</name>
        <condition>=</condition>
        <field>store_id</field>
      </key>
      <value>
        <name>store_sk</name>
        <rename>store_sk</rename>
        <type>Integer</type>
        <trim_type>none</trim_type>
      </value>
      <fail_on_multiple>N</fail_on_multiple>
      <eat_row_on_failure>N</eat_row_on_failure>
    </lookup>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>800</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Calculator</type>
    <name>Calculate Revenue Metrics</name>
    <calculation>
      <field_name>calc_gross_amount</field_name>
      <calc_type>MULTIPLY</calc_type>
      <field_a>quantity</field_a>
      <field_b>unit_price</field_b>
      <value_type>Number</value_type>
      <value_length>14</value_length>
      <value_precision>2</value_precision>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>calc_net_amount</field_name>
      <calc_type>SUBTRACT</calc_type>
      <field_a>calc_gross_amount</field_a>
      <field_b>discount_amount</field_b>
      <value_type>Number</value_type>
      <value_length>14</value_length>
      <value_precision>2</value_precision>
      <remove>N</remove>
    </calculation>
    <failIfNoFile>Y</failIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>976</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Insert fact_sales</name>
    <connection>mysql_dwh</connection>
    <table>fact_sales</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys>
    <specify_fields>Y</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields>
      <field>
        <stream_name>transaction_id</stream_name>
        <column_name>transaction_id</column_name>
      </field>
      <field>
        <stream_name>date_sk</stream_name>
        <column_name>date_sk</column_name>
      </field>
      <field>
        <stream_name>customer_sk</stream_name>
        <column_name>customer_sk</column_name>
      </field>
      <field>
        <stream_name>product_sk</stream_name>
        <column_name>product_sk</column_name>
      </field>
      <field>
        <stream_name>store_sk</stream_name>
        <column_name>store_sk</column_name>
      </field>
      <field>
        <stream_name>quantity</stream_name>
        <column_name>quantity</column_name>
      </field>
      <field>
        <stream_name>unit_price</stream_name>
        <column_name>unit_price</column_name>
      </field>
      <field>
        <stream_name>calc_gross_amount</stream_name>
        <column_name>gross_amount</column_name>
      </field>
      <field>
        <stream_name>discount_amount</stream_name>
        <column_name>discount_amount</column_name>
      </field>
      <field>
        <stream_name>calc_net_amount</stream_name>
        <column_name>net_amount</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1152</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read raw_transactions.csv</from>
      <to>Lookup Date SK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Date SK</from>
      <to>Lookup Customer SK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Customer SK</from>
      <to>Lookup Product SK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Product SK</from>
      <to>Lookup Store SK</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Lookup Store SK</from>
      <to>Calculate Revenue Metrics</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calculate Revenue Metrics</from>
      <to>Insert fact_sales</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>Tahap 5.5: Baca raw_transactions.csv, Database Lookup ke 4 dimensi (date, customer, product, store), kalkulasi metrik omzet, load ke fact_sales</note>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>64</xloc>
      <yloc>48</yloc>
      <width>880</width>
      <height>-1</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
