<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>load_dim_customer</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline ETL untuk membersihkan dan memuat data pelanggan ke dim_customer</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/10/16 10:00:00.000</created_date>
    <modified_date>2026/10/16 10:00:00.000</modified_date>
  </info>
  <transform>
    <type>CSVInput</type>
    <name>Read raw_customers.csv</name>
    <filename>${PROJECT_HOME}/data/raw/raw_customers.csv</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field>
        <name>customer_id</name>
        <length>50</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>customer_name</name>
        <length>150</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>email</name>
        <length>150</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>city</name>
        <length>100</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>province</name>
        <length>100</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>customer_segment</name>
        <length>50</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>144</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>StringOperations</type>
    <name>Normalize Customer Strings</name>
    <fields>
      <field>
        <in_stream_name>customer_id</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>upper</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
        <pad_len/>
        <pad_char/>
      </field>
      <field>
        <in_stream_name>customer_name</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
        <pad_len/>
        <pad_char/>
      </field>
      <field>
        <in_stream_name>email</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>lower</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
        <pad_len/>
        <pad_char/>
      </field>
      <field>
        <in_stream_name>city</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
        <pad_len/>
        <pad_char/>
      </field>
      <field>
        <in_stream_name>province</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
        <pad_len/>
        <pad_char/>
      </field>
      <field>
        <in_stream_name>customer_segment</in_stream_name>
        <out_stream_name/>
        <trim_type>both</trim_type>
        <lower_upper>none</lower_upper>
        <init_cap>no</init_cap>
        <mask_xml>none</mask_xml>
        <digits>none</digits>
        <remove_special_characters>none</remove_special_characters>
        <padding_type>none</padding_type>
        <pad_len/>
        <pad_char/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>384</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>InsertUpdate</type>
    <name>Insert / Update dim_customer</name>
    <lookup>
      <key>
        <name>customer_id</name>
        <field>customer_id</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>customer_id</name>
        <rename>customer_id</rename>
        <update>N</update>
      </value>
      <value>
        <name>customer_name</name>
        <rename>customer_name</rename>
        <update>Y</update>
      </value>
      <value>
        <name>email</name>
        <rename>email</rename>
        <update>Y</update>
      </value>
      <value>
        <name>city</name>
        <rename>city</rename>
        <update>Y</update>
      </value>
      <value>
        <name>province</name>
        <rename>province</rename>
        <update>Y</update>
      </value>
      <value>
        <name>customer_segment</name>
        <rename>customer_segment</rename>
        <update>Y</update>
      </value>
      <schema/>
      <table>dim_customer</table>
    </lookup>
    <commit>100</commit>
    <update_bypassed>N</update_bypassed>
    <connection>mysql_dwh</connection>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>624</xloc>
      <yloc>160</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Read raw_customers.csv</from>
      <to>Normalize Customer Strings</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Normalize Customer Strings</from>
      <to>Insert / Update dim_customer</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads>
    <notepad>
      <note>Tahap 5.2: Baca raw_customers.csv, normalisasi string (trim &amp; case format), muat dengan Surrogate Key ke dim_customer</note>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>64</xloc>
      <yloc>48</yloc>
      <width>720</width>
      <height>-1</height>
    </notepad>
  </notepads>
  <attributes/>
  <transform_error_handling/>
</pipeline>
