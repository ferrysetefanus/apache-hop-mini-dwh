<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>load_dim_date</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline ETL untuk mengisi tabel dimensi tanggal (dim_date)</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/10/16 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/10/16 10:00:00.000</modified_date>
  </info>
  <notepads>
    <notepad>
      <note>Tahap 5.1: Generate rentang tanggal 2 tahun (2025-2026) dan ekstrak atribut tanggal ke dim_date</note>
      <xloc>64</xloc>
      <yloc>48</yloc>
      <width>580</width>
      <heigth>27</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Generate 731 Days</from>
      <to>Add Day Offset</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Add Day Offset</from>
      <to>Calculate Date Attributes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calculate Date Attributes</from>
      <to>Format SK and Names</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Format SK and Names</from>
      <to>Insert / Update dim_date</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Generate 731 Days</name>
    <type>RowGenerator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <format>yyyy-MM-dd</format>
        <length>-1</length>
        <name>start_date</name>
        <nullif>2025-01-01</nullif>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
        <type>Date</type>
      </field>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field/>
    <limit>731</limit>
    <never_ending>N</never_ending>
    <row_time_field/>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Add Day Offset</name>
    <type>Sequence</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <use_counter>Y</use_counter>
    <use_database>N</use_database>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <min_value>0</min_value>
    <seqname>day_seq</seqname>
    <start_at>0</start_at>
    <valuename>day_offset</valuename>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Calculate Date Attributes</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <failIfNoFile>Y</failIfNoFile>
    <calculation>
      <calc_type>ADD_DAYS</calc_type>
      <field_a>start_date</field_a>
      <field_b>day_offset</field_b>
      <field_name>full_date</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Date</value_type>
    </calculation>
    <calculation>
      <calc_type>YEAR_OF_DATE</calc_type>
      <field_a>full_date</field_a>
      <field_name>year</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>MONTH_OF_DATE</calc_type>
      <field_a>full_date</field_a>
      <field_name>month</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>DAY_OF_MONTH</calc_type>
      <field_a>full_date</field_a>
      <field_name>day</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <calculation>
      <calc_type>QUARTER_OF_DATE</calc_type>
      <field_a>full_date</field_a>
      <field_name>quarter</field_name>
      <remove>N</remove>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <value_type>Integer</value_type>
    </calculation>
    <attributes/>
    <GUI>
      <xloc>480</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Format SK and Names</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var sdf = new java.text.SimpleDateFormat("yyyyMMdd");
var date_sk = java.lang.Integer.parseInt(sdf.format(full_date));

var monthSdf = new java.text.SimpleDateFormat("MMMM", java.util.Locale.ENGLISH);
var month_name = String(monthSdf.format(full_date));

var daySdf = new java.text.SimpleDateFormat("EEEE", java.util.Locale.ENGLISH);
var day_of_week = String(daySdf.format(full_date));
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>date_sk</name>
        <rename>date_sk</rename>
        <type>Integer</type>
        <length>9</length>
        <precision>0</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>month_name</name>
        <rename>month_name</rename>
        <type>String</type>
        <length>20</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>day_of_week</name>
        <rename>day_of_week</rename>
        <type>String</type>
        <length>20</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>688</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Insert / Update dim_date</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>mysql_dwh</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema/>
      <table>dim_date</table>
      <key>
        <name>date_sk</name>
        <field>date_sk</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>date_sk</name>
        <rename>date_sk</rename>
        <update>N</update>
      </value>
      <value>
        <name>full_date</name>
        <rename>full_date</rename>
        <update>Y</update>
      </value>
      <value>
        <name>day</name>
        <rename>day</rename>
        <update>Y</update>
      </value>
      <value>
        <name>month</name>
        <rename>month</rename>
        <update>Y</update>
      </value>
      <value>
        <name>month_name</name>
        <rename>month_name</rename>
        <update>Y</update>
      </value>
      <value>
        <name>quarter</name>
        <rename>quarter</rename>
        <update>Y</update>
      </value>
      <value>
        <name>year</name>
        <rename>year</rename>
        <update>Y</update>
      </value>
      <value>
        <name>day_of_week</name>
        <rename>day_of_week</rename>
        <update>Y</update>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>880</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
