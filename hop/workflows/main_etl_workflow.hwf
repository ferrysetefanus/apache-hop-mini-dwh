<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>main_etl_workflow</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Master ETL Workflow untuk orkestrasi seluruh pipeline dimensi dan fakta Mini Data Warehouse (food_dwh)</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/10/16 10:00:00.000</created_date>
  <modified_date>2026/10/16 10:00:00.000</modified_date>
  <workflow_version/>
  <parameters/>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <DayOfMonth>1</DayOfMonth>
      <weekDay>1</weekDay>
      <minutes>0</minutes>
      <hour>12</hour>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <name>Start</name>
      <description>Titik mulai eksekusi workflow</description>
      <type>SPECIAL</type>
      <attributes/>
      <xloc>80</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connections>
        <connection>
          <name>mysql_dwh</name>
          <waitfor>500</waitfor>
          <waittime>millisecond</waittime>
        </connection>
      </connections>
      <name>Check Database Connection</name>
      <description>Verifikasi koneksi aktif ke database food_dwh di localhost:3306</description>
      <type>CHECK_DB_CONNECTIONS</type>
      <attributes/>
      <xloc>240</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/hop/pipelines/load_dim_date.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>load_dim_date</name>
      <description>Pipeline pemuatan dimensi tanggal</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>384</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/hop/pipelines/load_dim_customer.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>load_dim_customer</name>
      <description>Pipeline pembersihan dan pemuatan dimensi pelanggan</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>528</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/hop/pipelines/load_dim_product.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>load_dim_product</name>
      <description>Pipeline validasi dan pemuatan dimensi produk</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>672</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/hop/pipelines/load_dim_store.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>load_dim_store</name>
      <description>Pipeline normalisasi dan pemuatan dimensi toko retail</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>816</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename>${PROJECT_HOME}/hop/pipelines/load_fact_sales.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <create_parent_folder>N</create_parent_folder>
      <set_logfile>N</set_logfile>
      <set_append_logfile>N</set_append_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <wait_until_finished>Y</wait_until_finished>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <run_configuration>local</run_configuration>
      <name>load_fact_sales</name>
      <description>Pipeline pemuatan fakta transaksi dengan lookup surrogate key dimensi</description>
      <type>PIPELINE</type>
      <attributes/>
      <xloc>960</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Basic</loglevel>
      <logsubject>ETL WORKFLOW COMPLETED SUCCESSFULLY</logsubject>
      <logmessage>================================================================================
[SUCCESS] Apache Hop Mini Data Warehouse ETL Workflow Completed!
- Database Connection : Verified (mysql_dwh)
- Dimensions Loaded   : dim_date, dim_customer, dim_product, dim_store
- Fact Table Loaded   : fact_sales (Surrogate Keys &amp; Metrics Populated)
================================================================================</logmessage>
      <name>Success Logging</name>
      <description>Logging notifikasi penyelesaian proses ETL</description>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>1104</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description>Penyelesaian sukses workflow</description>
      <type>SUCCESS</type>
      <attributes/>
      <xloc>1248</xloc>
      <yloc>160</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>Workflow dibatalkan karena terjadi kesalahan pada tahap koneksi atau pipeline ETL!</message>
      <always_log_rows>N</always_log_rows>
      <name>Abort Workflow</name>
      <description>Penghentian darurat jika salah satu pipeline mengalami kegagalan</description>
      <type>ABORT</type>
      <attributes/>
      <xloc>608</xloc>
      <yloc>432</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Check Database Connection</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check Database Connection</from>
      <to>load_dim_date</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Check Database Connection</from>
      <to>Abort Workflow</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_dim_date</from>
      <to>load_dim_customer</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_dim_date</from>
      <to>Abort Workflow</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_dim_customer</from>
      <to>load_dim_product</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_dim_customer</from>
      <to>Abort Workflow</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_dim_product</from>
      <to>load_dim_store</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_dim_product</from>
      <to>Abort Workflow</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_dim_store</from>
      <to>load_fact_sales</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_dim_store</from>
      <to>Abort Workflow</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_fact_sales</from>
      <to>Success Logging</to>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>load_fact_sales</from>
      <to>Abort Workflow</to>
      <evaluation>N</evaluation>
      <unconditional>N</unconditional>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Success Logging</from>
      <to>Success</to>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
      <enabled>Y</enabled>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <note>Tahap 6: Master ETL Workflow (main_etl_workflow.hwf)
Alur: Check DB -> Load Dim Date -> Load Dim Customer -> Load Dim Product -> Load Dim Store -> Load Fact Sales -> Success Logging</note>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <xloc>64</xloc>
      <yloc>48</yloc>
      <width>750</width>
      <height>50</height>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
